{
  "expo": {
    "name": "Open Student",
    "slug": "openstudent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openstudent",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "CFBundleDevelopmentRegion": "he",
        "CFBundleLocalizations": [
          "he",
          "he",
          "he",
          "he"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ronkaa.openstudent"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "image": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://openstudent.expo.app"
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.ronkaa.openstudent.widgets",
          "groupIdentifier": "group.com.ronkaa.openstudent",
          "widgets": [
            {
              "name": "DeadlinesWidget",
              "displayName": "מטלות קרובות",
              "description": "המטלות הפתוחות הקרובות ביותר",
              "ios": { "supportedFamilies": ["systemSmall", "systemMedium"] }
            },
            {
              "name": "ExamWidget",
              "displayName": "המבחן הבא",
              "description": "ספירה לאחור למבחן הקרוב",
              "ios": { "supportedFamilies": ["systemSmall"] }
            },
            {
              "name": "ProgressWidget",
              "displayName": "התקדמות בתואר",
              "description": "אחוז השלמת התואר והממוצע",
              "ios": { "supportedFamilies": ["systemSmall"] }
            }
          ]
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "router": {},
      "eas": {
        "projectId": "3c4f0d84-19a5-4ca6-b7e2-09e82a6600ec"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ronkaa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c4f0d84-19a5-4ca6-b7e2-09e82a6600ec"
    }
  }
}