{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "developmentClient": true,
        "distribution": "internal",
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_POSTHOG_API_KEY": "phc_Ao9Yvs2vCU6KYKVWQjtNTnjd29ah9Qb9Nur9aLJ5NEBK",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "channel": "development"
    },
    "preview": {
      "ios": {
        "simulator": true,
        "autoIncrement": true
      },
      "android": {
        "distribution": "internal",
        "autoIncrement": true,
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_POSTHOG_API_KEY": "phc_Ao9Yvs2vCU6KYKVWQjtNTnjd29ah9Qb9Nur9aLJ5NEBK",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_POSTHOG_API_KEY": "phc_Ao9Yvs2vCU6KYKVWQjtNTnjd29ah9Qb9Nur9aLJ5NEBK",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}